<local:MyCard Title="Minecraft命令行客户端" Margin="0,0,0,15" CanSwap="True" IsSwapped="False">
    <StackPanel Margin="25,40,23,15">
        <local:MyListItem  Margin="-5,2,-5,8" Logo="https://mccteam.github.io/images/MCC_logo.png" Title="Minecraft命令行客户端" Info="Minecraft 控制台客户端 (MCC) 是一个基于 C# 的轻量化开源 Minecraft Java 客户端。" EventType="打开网页" EventData="https://mccteam.github.io/l10n/zh-Hans/" Type="Clickable" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <local:MyButton Margin="0,0,10,0" Width="100" Height="35" ColorType="Highlight" Text="启动" ToolTip="启动Minecraft命令行客户端">
                <local:CustomEventService.Events>
                    <local:CustomEventCollection>
                        <local:CustomEvent Type="执行命令" Data="{minecraft}MinecraftClient\MinecraftClient.exe" />
                        <local:CustomEvent Type="弹出提示" Data="正在启动Minecraft命令行客户端..." />
                    </local:CustomEventCollection>
                </local:CustomEventService.Events>
            </local:MyButton>
            <local:MyButton Margin="0,0,10,0" Width="100" Height="35" ColorType="Highlight" Text="配置" ToolTip="打开Minecraft命令行客户端配置文件">
                <local:CustomEventService.Events>
                    <local:CustomEventCollection>
                        <local:CustomEvent Type="执行命令" Data="{minecraft}MinecraftClient\MinecraftClient.ini" />
                        <local:CustomEvent Type="弹出提示" Data="正在打开Minecraft命令行客户端配置文件..." />
                    </local:CustomEventCollection>
                </local:CustomEventService.Events>
            </local:MyButton>
        </StackPanel>
    </StackPanel>
</local:MyCard>

